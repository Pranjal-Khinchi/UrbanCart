# ===== SERVER =====
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=

# ===== PRIMARY DATABASE (main UrbanCart application data) =====
# Format: mongodb+srv://<user>:<password>@<cluster>/urbancart_student?retryWrites=true&w=majority
MONGODB_URI_PRIMARY=

# ===== TEACHER DATABASE (audit logs ONLY) =====
# Format: mongodb+srv://<user>:<password>@<cluster>/urbancart_teacher?retryWrites=true&w=majority
MONGODB_URI_TEACHER=

# ===== OPTIONAL: demo admin account created by the seed script =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== CLIENT (Vite exposes only VITE_ prefixed vars, never put secrets here) =====
VITE_API_URL=http://localhost:5000/api
